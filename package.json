{
  "name": "scannerpdf",
  "version": "1.0.0",
  "description": "Escáner de imágenes a PDF con Node.js, Express y Tailwind CSS",
  "main": "src/server.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/styles.css --minify",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/scanner.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
